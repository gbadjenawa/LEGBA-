<body>

  <header class="topbar">
    <div class="top-inner">
      <div class="brand">
        <div class="logo">🌱</div>
        <div>AGRINOVA<small>BOUTIQUE EN LIGNE</small></div>
      </div>
      <div class="conn"><span class="dot"></span> Bénin — Ventes &amp; Livraisons</div>
      <nav class="nav">
        <button id="nav-shop" class="active" onclick="setView('shop')">Boutique</button>
        <button id="nav-cart" onclick="setView('cart')">Panier (<span id="cart-count-badge">0</span>)</button>
        <button id="nav-admin" onclick="setView('admin')">Administration</button>
      </nav>
    </div>
  </header>

  <div class="wrap">
    <!-- VUE BOUTIQUE -->
    <div id="view-shop">
      <div class="hero">
        <div>
          <span class="eyebrow">Vos achats, simplement.</span>
          <h1>Bienvenue chez AGRINOVA</h1>
          <p>Découvrez nos produits agricoles et transformés au Bénin. Ajoutez vos articles préférés au panier et passez commande en quelques clics.</p>
        </div>
        <div class="hero-bubble">🛍️</div>
      </div>

      <div class="toolbar">
        <input type="text" id="search-input" class="search" placeholder="Rechercher un produit..." oninput="filterCatalog()">
        <div class="field">
          <select id="cat-filter" onchange="filterCatalog()">
            <option value="all">Toutes les catégories</option>
          </select>
        </div>
      </div>

      <div class="section-title">
        <h2>Catalogue des produits</h2>
        <span class="muted" id="catalog-count">0 produit disponible</span>
      </div>
      <div class="products" id="catalog-grid"></div>
    </div>

    <!-- VUE PANIER -->
    <div id="view-cart" class="hidden">
      <h2>Mon panier</h2>
      <div class="split">
        <div class="cart-drawer" id="cart-list-container">
          <!-- Injecté par JS -->
        </div>
